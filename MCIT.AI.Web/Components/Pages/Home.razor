@page "/"

<PageTitle>Home | MCIT.AI</PageTitle>

<main class="home">
    <section class="hero" aria-labelledby="home-title">
        <div class="hero-content">
            <h1 id="home-title">From first thought<br />to next step.</h1>
            <p>Work through an idea, draft a message, or get unstuck with the MCIT.AI assistant.</p>
            <a class="hero-action" href="chatbot">Start a chat <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-orbit" aria-hidden="true"></div>
    </section>

    <section aria-labelledby="tools-title">
        <h2 id="tools-title">Tools</h2>
        <div class="tools-grid">
            <a class="tool" href="chatbot">
                <div>
                    <h3>Chatbot</h3>
                    <p>Ask questions and refine answers in one conversation.</p>
                </div>
                <span aria-hidden="true">→</span>
            </a>
        </div>
    </section>
</main>
